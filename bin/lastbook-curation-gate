#!/usr/bin/env python3
"""Offline curation-contract gate for Lastbook's content/topics and gaps.json.

Upstream ships tools/validate_topics.py, but it needs a downloaded library
(library-data/catalog.json) and only checks doc ids, page ranges and labels.
The written contract in content/SCHEMA.md (reading counts, note length, limits
traceability, learning routes, gap coverage) is not machine-checked anywhere.
This tool checks that contract with no library, no network and no third-party
packages. Exit codes: 0 clean, 1 findings, 2 usage/input error.
"""
import argparse
import json
import re
import sys
from pathlib import Path

RULES = {
    "LB01": "id must equal the file stem",
    "LB02": "required top-level fields present",
    "LB03": "mode is now or learn",
    "LB04": "learn topics define an ordered route",
    "LB05": "each choice offers 1-4 readings",
    "LB06": "prepare holds 3-8 readings",
    "LB07": "learn holds 4-10 readings",
    "LB08": "limits entries carry text and a source reference",
    "LB09": "note is at most 30 words",
    "LB10": "readings carry a label",
    "LB11": "keywords are at least 3 and unique",
    "LB12": "no bucket lists the same source twice",
    "LB13": "related names an existing topic, not itself",
    "LB14": "related links are symmetric",
    "LB15": "intro is one or two sentences",
    "LB16": "no dose/quantity leaking into intro or hints",
    "LB17": "route steps have title, goal and readings",
    "LB18": "gap domain has a topic file; entries are usable",
    "LB19": "same gap statement is not filed under two domains",
    "LB20": "now topics offer at least one choice",
}
SEVERITY = {r: ("warning" if r in ("LB14", "LB16", "LB19", "LB20") else "error") for r in RULES}

QUANTITY = re.compile(
    r"\b\d+(?:\.\d+)?\s*(?:%|mg|ml|l|g|kg|oz|lb|cups?|tsp|tbsp|drops?|tablets?|hours?|minutes?|days?)\b",
    re.I,
)
SENTENCE_SPLIT = re.compile(r"(?<=[.!?])\s+")


def words(text):
    return [w for w in re.split(r"\s+", str(text).strip()) if w]


def norm(text):
    return re.sub(r"[^a-z0-9]+", " ", str(text).lower()).strip()


class Findings:
    def __init__(self):
        self.items = []

    def add(self, rule, topic, message, path=""):
        self.items.append(
            {
                "rule": rule,
                "severity": SEVERITY[rule],
                "topic": topic,
                "message": message,
                "path": path,
            }
        )


def reference(item):
    """Stable identity of a reading: doc+page, doc, or zim path."""
    if item.get("zim"):
        return "zim:" + str(item["zim"])
    doc = str(item.get("doc", ""))
    return "doc:%s#%s" % (doc, item.get("page", "-"))


def readings(topic):
    """Yield (bucket, index, item) over every reading a topic publishes."""
    for key in ("prepare", "learn"):
        for i, item in enumerate(topic.get(key, [])):
            yield key, i, item
    for c in topic.get("choices", []):
        for i, item in enumerate(c.get("read", [])):
            yield "choice:%s" % c.get("id", "?"), i, item
    for s in topic.get("route", []):
        for i, item in enumerate(s.get("read", [])):
            yield "route:%s" % s.get("title", "?"), i, item


def check_topic(t, stem, known_ids):
    f = Findings()
    where = "content/topics/%s.json" % stem

    for field in ("id", "mode", "title", "short", "intro", "keywords"):
        if field not in t:
            f.add("LB02", stem, "missing field %r" % field, where)
    if t.get("id") != stem:
        f.add("LB01", stem, "id %r != file stem %r" % (t.get("id"), stem), where)
    if t.get("mode") not in ("now", "learn"):
        f.add("LB03", stem, "mode %r is not now/learn" % (t.get("mode"),), where)

    kw = t.get("keywords", [])
    if len(kw) < 3:
        f.add("LB11", stem, "only %d keyword(s)" % len(kw), where)
    if len(set(kw)) != len(kw):
        f.add("LB11", stem, "duplicate keyword(s)", where)

    sentences = [s for s in SENTENCE_SPLIT.split(str(t.get("intro", "")).strip()) if s]
    if len(sentences) > 2:
        f.add("LB15", stem, "intro has %d sentences" % len(sentences), where)

    if t.get("mode") == "now" and not t.get("choices"):
        f.add("LB20", stem, "now topic has no choices", where)
    if t.get("mode") == "learn" and not t.get("route"):
        f.add("LB04", stem, "learn topic has no route", where)

    for c in t.get("choices", []):
        n = len(c.get("read", []))
        if not 1 <= n <= 4:
            f.add("LB05", stem, "choice %r offers %d readings (1-4)" % (c.get("id", "?"), n), where)
        if QUANTITY.search(str(c.get("hint", ""))):
            f.add("LB16", stem, "choice %r hint contains a quantity" % c.get("id", "?"), where)

    for key, lo, hi in (("prepare", 3, 8), ("learn", 4, 10)):
        n = len(t.get(key, []))
        if not lo <= n <= hi:
            f.add("LB06" if key == "prepare" else "LB07", stem,
                  "%s holds %d readings (%d-%d)" % (key, n, lo, hi), where)

    if QUANTITY.search(str(t.get("intro", ""))):
        f.add("LB16", stem, "intro contains a quantity", where)

    for idx, lim in enumerate(t.get("limits", [])):
        if not str(lim.get("text", "")).strip():
            f.add("LB08", stem, "limit %d has no text" % idx, where)
        elif not (lim.get("doc") or lim.get("zim")):
            f.add("LB08", stem, "limit %d has no doc/zim" % idx, where)

    seen = {}
    for bucket, i, item in readings(t):
        if not (item.get("doc") or item.get("zim")):
            f.add("LB10", stem, "%s[%d] has no doc/zim" % (bucket, i), where)
        if bucket.startswith(("prepare", "learn", "choice", "route")) and not item.get("label"):
            f.add("LB10", stem, "%s[%d] has no label" % (bucket, i), where)
        note = item.get("note")
        if note is not None and len(words(note)) > 30:
            f.add("LB09", stem, "%s[%d] note has %d words (>30)" % (bucket, i, len(words(note))), where)
        ref = reference(item)
        bucket_seen = seen.setdefault(bucket, set())
        if ref in bucket_seen:
            f.add("LB12", stem, "%s lists %s twice" % (bucket, ref), where)
        bucket_seen.add(ref)

    for s in t.get("route", []):
        if not str(s.get("title", "")).strip() or not str(s.get("goal", "")).strip() or not s.get("read"):
            f.add("LB17", stem, "route step %r incomplete" % s.get("title", "?"), where)

    related = t.get("related", [])
    for r in related:
        if r == stem:
            f.add("LB13", stem, "related points at itself", where)
        elif r not in known_ids:
            f.add("LB13", stem, "related names unknown topic %r" % r, where)
    return f.items


def check_related_symmetry(topics, stem, findings):
    for other in topics[stem].get("related", []):
        if other in topics and stem not in topics[other].get("related", []):
            findings.append(
                {
                    "rule": "LB14",
                    "severity": SEVERITY["LB14"],
                    "topic": stem,
                    "message": "related -> %s is one-way (%s does not link back)" % (other, other),
                    "path": "content/topics/%s.json" % stem,
                }
            )


def check_gaps(gaps, topics, findings):
    if not isinstance(gaps, dict):
        findings.append({"rule": "LB18", "severity": "error", "topic": "-",
                         "message": "gaps.json is not an object of domain -> {missing, disagree}",
                         "path": "content/gaps.json"})
        return
    seen = {}
    for domain, bucket in sorted(gaps.items()):
        if domain not in topics:
            findings.append({"rule": "LB18", "severity": "error", "topic": domain,
                             "message": "gap domain has no content/topics/%s.json" % domain,
                             "path": "content/gaps.json"})
        if not isinstance(bucket, dict):
            findings.append({"rule": "LB18", "severity": "error", "topic": domain,
                             "message": "domain value is not an object", "path": "content/gaps.json"})
            continue
        for kind in ("missing", "disagree"):
            entries = bucket.get(kind, [])
            if not isinstance(entries, list):
                findings.append({"rule": "LB18", "severity": "error", "topic": domain,
                                 "message": "%s is not a list" % kind, "path": "content/gaps.json"})
                continue
            for entry in entries:
                if not isinstance(entry, str) or not entry.strip():
                    findings.append({"rule": "LB18", "severity": "error", "topic": domain,
                                     "message": "empty %s entry" % kind, "path": "content/gaps.json"})
                    continue
                key = norm(entry)
                if key in seen and seen[key] != domain:
                    findings.append({"rule": "LB19", "severity": SEVERITY["LB19"], "topic": domain,
                                     "message": "same gap also filed under %s" % seen[key],
                                     "path": "content/gaps.json"})
                seen.setdefault(key, domain)


def load(path, findings, label):
    try:
        with open(path, encoding="utf-8") as fh:
            return json.load(fh)
    except (OSError, ValueError) as exc:
        findings.append({"rule": "LB00", "severity": "error", "topic": label,
                         "message": "cannot read %s: %s" % (path, exc), "path": str(path)})
        return None


def collect(args):
    findings = Findings()
    topic_dir = Path(args.topics)
    if not topic_dir.is_dir():
        return None, None, ["topics directory not found: %s" % topic_dir]
    topics = {}
    for path in sorted(topic_dir.glob("*.json")):
        data = load(path, findings, path.stem)
        if data is None:
            continue
        if not isinstance(data, dict):
            findings.add("LB02", path.stem, "topic file is not an object", str(path))
            continue
        topics[path.stem] = data
    if not topics:
        return None, None, ["no topic files found under %s" % topic_dir]

    for stem, data in sorted(topics.items()):
        findings.items.extend(check_topic(data, stem, set(topics)))
    for stem in sorted(topics):
        check_related_symmetry(topics, stem, findings.items)

    gaps = None
    if args.gaps:
        gaps = load(Path(args.gaps), findings, "gaps.json")
        if gaps is not None:
            check_gaps(gaps, topics, findings.items)
    return topics, gaps, findings.items


def gap_summary(gaps):
    if not isinstance(gaps, dict):
        return {}
    out = {}
    for domain, bucket in sorted(gaps.items()):
        if isinstance(bucket, dict):
            out[domain] = {
                "missing": len([x for x in bucket.get("missing", []) if isinstance(x, str)]),
                "disagree": len([x for x in bucket.get("disagree", []) if isinstance(x, str)]),
            }
    return out


def main(argv):
    ap = argparse.ArgumentParser(prog="lastbook-curation-gate",
                                 description="Check Lastbook's content/topics and gaps.json against content/SCHEMA.md, offline.")
    sub = ap.add_subparsers(dest="cmd")
    for name, help_text in (("check", "check the curation contract"),
                            ("gaps", "report the curator gap backlog")):
        p = sub.add_parser(name, help=help_text)
        p.add_argument("--topics", default="content/topics", help="topic directory (default: content/topics)")
        p.add_argument("--gaps", default="content/gaps.json", help="gaps.json (default: content/gaps.json)")
        p.add_argument("--json", action="store_true", help="emit one JSON object on stdout")
        p.add_argument("--strict", action="store_true", help="treat warnings as findings for the exit code")
    args = ap.parse_args(argv)
    if args.cmd is None:
        ap.print_help(sys.stderr)
        return 2

    topics, gaps, items = collect(args)
    if topics is None:
        payload = {"schema_version": 1, "command": args.cmd, "ok": False,
                   "error": "; ".join(items), "findings": []}
        print(json.dumps(payload, indent=2, sort_keys=True) if args.json else "error: " + payload["error"])
        return 2

    errors = [i for i in items if i["severity"] == "error"]
    warnings = [i for i in items if i["severity"] == "warning"]
    failed = bool(errors) or (args.strict and bool(warnings))

    if args.cmd == "gaps":
        counts = gap_summary(gaps)
        payload = {"schema_version": 1, "command": "gaps", "topics": len(topics),
                   "domains": len(counts), "counts": counts,
                   "missing_total": sum(v["missing"] for v in counts.values()),
                   "disagree_total": sum(v["disagree"] for v in counts.values())}
        if args.json:
            print(json.dumps(payload, indent=2, sort_keys=True))
        else:
            print("domains: %d  topics: %d" % (payload["domains"], payload["topics"]))
            for domain, v in counts.items():
                print("  %-12s missing %2d  disagree %2d" % (domain, v["missing"], v["disagree"]))
            print("total: %d missing, %d disagree" % (payload["missing_total"], payload["disagree_total"]))
        return 0

    payload = {
        "schema_version": 1,
        "command": "check",
        "topics": len(topics),
        "ok": not failed,
        "counts": {"error": len(errors), "warning": len(warnings)},
        "rules": RULES,
        "findings": sorted(items, key=lambda i: (i["topic"], i["rule"])),
        "gaps": gap_summary(gaps) if gaps else {},
    }
    if args.json:
        print(json.dumps(payload, indent=2, sort_keys=True))
    else:
        for item in payload["findings"]:
            print("%-7s %-4s %-12s %s" % (item["severity"].upper(), item["rule"], item["topic"], item["message"]))
        print("topics: %d  errors: %d  warnings: %d" % (len(topics), len(errors), len(warnings)))
    return 1 if failed else 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except BrokenPipeError:
        sys.exit(2)
